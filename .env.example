# Uygulamanın genel adresi. Davet linkleri bu adres üzerinden üretilir.
# Production'da örn. https://aysemehmet.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Admin girişi
# ---------------------------------------------------------------------------
#
# Şifre hash'i ve rastgele bir AUTH_SECRET üretmek için:
#
#     npm run hash-password -- "şifreniz"
#
# Çıktıyı .env.local dosyasına yazın. Düz şifre hiçbir yere kaydedilmez.
#
# Yerel geliştirme varsayılanı: .env.local dosyası kurulumda
# "gelistirme2026" şifresiyle oluşturuldu. Üretime çıkmadan önce mutlaka
# kendi şifrenizle yeniden üretin.

ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Aşağıdakiler backend fazında (Adım 8+) gereklidir.
# Frontend fazında veriler .data/dev-store.json dosyasında tutulur.
# ---------------------------------------------------------------------------

# Supabase proje adresi ve gizli anahtarı.
# service_role anahtarı yalnızca sunucuda kullanılır, tarayıcıya asla gönderilmez.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
